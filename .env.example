# Vórtex Membros: copie para .env.local (cp .env.example .env.local) e preencha.
# Nunca faça commit do .env.local. Em produção, cadastre os mesmos nomes na Vercel.

# Banco de dados (obrigatório).
# No seu computador, sem conta nenhuma: banco local PGlite em arquivo (crie com `npm run db:dev`).
DATABASE_URL=pglite:./.data/dev
# Produção: Supabase → Connect → Session pooler (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
#DATABASE_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Opcional: "transaction" troca a conexão para a porta 6543 (não recomendado na Vercel).
#DB_POOL_MODE=
# Criadas sozinhas pela integração Supabase da Vercel; usadas só se DATABASE_URL estiver vazio.
#POSTGRES_URL=
#POSTGRES_URL_NON_POOLING=

# Endereço público do site, sem barra no fim (vai nos links dos e-mails).
#APP_URL=https://seu-dominio.com.br

# Primeiro administrador, criado no deploy de produção sem senha (entre por "Esqueceu sua senha?").
#BOOTSTRAP_ADMIN_EMAIL=contato@exemplo.com
#BOOTSTRAP_ADMIN_NAME=Ana Souza

# Segredo que protege /api/cron/emails (gere com: openssl rand -hex 32).
#CRON_SECRET=

# E-mails pelo Brevo. Sem BREVO_API_KEY os e-mails ficam na fila e nada quebra.
#BREVO_API_KEY=
# Remetente autenticado no Brevo.
#EMAIL_FROM_EMAIL=nao-responda@seu-dominio.com.br
# Nome do remetente (padrão: o nome do site configurado no painel).
#EMAIL_FROM_NAME=Sua Empresa
# Limite de envios por dia (padrão 300, o do plano grátis).
#BREVO_DAILY_LIMIT=300

# Recebe aviso por e-mail quando o servidor dá erro em produção (padrão: o administrador inicial).
#ALERT_EMAIL=

# 1 = carrega conteúdo de exemplo no deploy de produção. Deixe vazio em produção real.
#SEED_DEMO=
# 1 = deixa `npm run seed` rodar mesmo com alunos cadastrados (apaga o conteúdo de exemplo). Só em teste.
#SEED_ALLOW_DESTRUCTIVE=
