    "lint": "eslint",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:sync": "tsx scripts/seed-sync.ts",
    "admin:ensure": "tsx scripts/ensure-admin.ts",
    "seed:clean": "tsx scripts/seed-clean.ts",
    "db:dev": "tsx scripts/dev-db.ts"
  },
