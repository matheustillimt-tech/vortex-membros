    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then drizzle-kit migrate && npm run seed:sync && npm run admin:ensure && if [ \"$SEED_DEMO\" = \"1\" ]; then npm run seed; fi; fi && next build",
